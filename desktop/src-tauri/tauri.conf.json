{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mock Test Hub",
  "version": "1.0.1",
  "identifier": "app.mocktesthub.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mock Test Hub",
    "copyright": "Mock Test Hub",
    "category": "Education",
    "shortDescription": "Mock tests, typing tests and job notices",
    "longDescription": "Mock Test Hub for Windows: practise mock tests and typing tests in a distraction-free exam window, and get alerts for new job notices.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "../branding/nsis-header.bmp",
        "sidebarImage": "../branding/nsis-sidebar.bmp"
      }
    }
  }
}
