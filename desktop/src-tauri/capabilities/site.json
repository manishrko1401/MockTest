{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site",
  "description": "What the Mock Test Hub website may ask the app to do: exam mode, exit, notifications, the encrypted offline-test store and the app's version number. Nothing else (no files, no shell).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://mocktesthub.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "permissions": [
    "core:event:default",
    "core:app:allow-version",
    "allow-set-exam-mode",
    "allow-exit-app",
    "allow-offline-device-key",
    "allow-offline-store",
    "allow-offline-list",
    "allow-offline-open",
    "allow-offline-delete",
    "allow-offline-add-attempt",
    "allow-offline-attempts",
    "allow-outbox-list",
    "allow-outbox-remove",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
